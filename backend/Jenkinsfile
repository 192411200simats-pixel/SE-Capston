pipeline {

    agent any

    environment {
        GRADLE_USER_HOME = "${WORKSPACE}/.gradle"
        ANDROID_HOME = "/opt/android-sdk"
        ANDROID_SDK_ROOT = "/opt/android-sdk"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'SE-Capston repository already checked out by Jenkins.'
            }
        }

        stage('Check Java') {
            steps {
                sh 'java -version'
                sh 'echo JAVA_HOME=$JAVA_HOME'
            }
        }

        stage('Check Android SDK') {
            steps {
                sh 'echo ANDROID_HOME=$ANDROID_HOME'
                sh 'ls -la $ANDROID_HOME'
                sh 'ls -la $ANDROID_HOME/platforms'
                sh 'ls -la $ANDROID_HOME/build-tools'
            }
        }

        stage('Prepare Gradle') {
            steps {
                sh '''
                    mkdir -p "$GRADLE_USER_HOME"
                    chmod +x gradlew
                    echo "GRADLE_USER_HOME=$GRADLE_USER_HOME"
                '''
            }
        }

        stage('Build Android APK') {
            steps {
                sh '''
                    ./gradlew assembleDebug \
                        --no-daemon \
                        --stacktrace
                '''
            }
        }

    }

    post {

        success {
            archiveArtifacts(
                artifacts: 'app/build/outputs/apk/debug/*.apk',
                fingerprint: true
            )

            echo 'Android APK build successful!'
        }

        failure {
            echo 'Android APK build failed.'
        }

        always {
            echo 'Jenkins pipeline completed.'
        }
    }
}